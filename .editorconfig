# EditorConfig helps developers define and maintain consistent
# coding styles between different editors and IDEs
# editorconfig.org
#
# Every file is LF, which is also how .gitattributes stores it. The sections below repeat
# the setting where something breaks without it, and say what.

root = true

[*]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space
indent_size = 2

# Markdown treats two trailing spaces as a hard line break, so they must survive.
[*.md]
trim_trailing_whitespace = false

# CRLF makes a script fail with "bad interpreter". These are also what shellcheck reads.
[{*.sh,*.bash}]
end_of_line = lf
indent_size = 2

# .yamllint sets new-lines: unix, so a CRLF file here fails the lint job outright.
[{*.yml,*.yaml}]
end_of_line = lf
indent_size = 2

# ruff and bandit read these. Four spaces, as PEP 8 asks.
[*.py]
end_of_line = lf
indent_size = 4

# The preload library and the wrapper. cppcheck and the compiler warnings gate them.
[{*.c,*.h}]
end_of_line = lf
indent_size = 2

# The path sets and the tail flags are read line by line by core/phobos-filesystem.sh with
# `while IFS= read -r`. A carriage return would end up inside a path: a read or execute path
# would then name nothing and be dropped, and a write path would be created under the wrong
# name, so the run would lose access it was granted. LF here is load-bearing, not cosmetic.
[{*.cfg,*.paths,*.flags,*.rules}]
end_of_line = lf

[*.json]
indent_size = 2

[Dockerfile*]
indent_size = 4
