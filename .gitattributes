# Every file Git detects as text is stored with LF line endings, on every platform.
# Phobos runs on Linux throughout: the path sets are read with `while IFS= read -r`, where a
# carriage return becomes part of a bind path, and a CRLF script fails with "bad
# interpreter". CRLF was only ever an editor artefact here, and ls1intum/phobos#15 removed
# the last of it. To check rather than trust this comment:
#
#     git ls-files --eol | grep crlf
* text=auto eol=lf

# Binary files, so that Git never applies text conversion to them. Phobos ships a
# compiled preload library in version control; a Git that normalised it would corrupt it.
*.so       binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.tar      binary
*.gz       binary
*.tgz      binary
*.zip      binary
*.7z       binary

# Not exported in an archive.
.gitattributes export-ignore
.gitignore     export-ignore
