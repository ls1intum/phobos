# Editor and IDE state.
/.idea
/.vscode

# Scratch checkouts used while trying the prune phase against a real exercise.
/test-repos/**

# Build output. The C sources are compiled inside the run-phase image, but a contributor
# who compiles a program by hand leaves the object files behind. No compiled binary is
# committed; *.so is deliberately absent here so that .gitattributes, which marks it binary,
# still catches a stray one rather than normalising it.
/build/
*.o
*.a

# Python. The prune orchestrator and the helpers under pruner/src are run directly.
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Output of a prune run. The path sets that are meant to be kept are committed under
# protecter/src/config; everything a run drops beside them is scratch.
/build/pruner/path_sets/

# Sessions of the recording pruner (phobos-record), written by its compose services. A recording
# describes one instructor's sessions and is reviewed before its policy is kept anywhere.
/build/pruner/recordings/
