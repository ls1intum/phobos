# Editor and IDE state.
/.idea
/.vscode

# Scratch checkouts used while trying the prune phase against a real exercise.
/test-repos/**

# Build output. The C sources are compiled inside the run-phase image, but a contributor
# who compiles the preload library by hand leaves the object files behind. No
# libnetblocker.so is committed any more, so *.so is deliberately absent here: see
# .gitattributes, which marks it binary so that a stray one is never normalised, and
# AGENTS.md, which says why none may be checked in.
/build/
*.o
*.a

# Python. The prune orchestrator and the helpers under var/tmp are run directly.
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Output of a prune run. The path sets that are meant to be kept are committed under
# core/config; everything a run drops beside them is scratch.
/var/tmp/path_sets/
/var/tmp/pruning/*.log
